# Plaid API Credentials
# Get these from https://dashboard.plaid.com/team/keys
PLAID_CLIENT_ID=your_plaid_client_id_here
PLAID_SECRET=your_plaid_secret_here
PLAID_ENVIRONMENT=sandbox
# PLAID_ENVIRONMENT options: sandbox, development, production

# Plaid Access Token
# This is obtained after linking your bank account through Plaid Link
PLAID_ACCESS_TOKEN=access-sandbox-your-token-here

# Google Sheets Configuration
# The ID of your Google Sheet (found in the URL)
# Example: https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Optional: Specify which sheet tab to use (default is "Transactions")
GOOGLE_SHEET_TAB_NAME=Transactions
